DB_HOST=localhost
DB_PORT=5432
DB_USER=sportspace
DB_PASSWORD=sportspace
DB_NAME=sportspace

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me
PORT=3000

# VNPAY Sandbox — register a test merchant at sandbox.vnpayment.vn/devreg/
VNP_TMN_CODE=your-tmn-code
VNP_HASH_SECRET=your-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payments/return

# FCM push — Firebase service account JSON as a single-line string. Optional:
# when unset, push delivery is skipped (logged) but notification history
# still works normally.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email đặt lại mật khẩu — SMTP tổng quát, có thể trỏ vào Gmail SMTP, Mailtrap,
# SendGrid SMTP relay, hoặc bất kỳ dịch vụ nào khác. Bỏ trống SMTP_HOST khi dev
# local: email sẽ được log ra console thay vì gửi thật, không chặn luồng.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sportspace.dev
WEB_URL=http://localhost:3001
