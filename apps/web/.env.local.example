# URL của NestJS backend. Chỉ dùng ở server (Server Component/Action/proxy),
# không cần NEXT_PUBLIC_ vì client không gọi thẳng backend.
BACKEND_API_URL=http://localhost:3000

# URL công khai của backend, dùng để trình duyệt tải trực tiếp file tĩnh
# (vd ảnh cụm sân tại /uploads/venues/...) — khác BACKEND_API_URL ở trên vì
# đây KHÔNG phải gọi API JSON, mà là thẻ <img src> trình duyệt tự fetch.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3000
